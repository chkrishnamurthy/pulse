<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminders and band alerts. Asked only when the user switches one on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect, read-only: today's numbers on this phone (LocalLane). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <!-- Live steps: the phone's own step sensor, only while Pulse is open. Asked only when the user switches it on. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

    <!-- Live heart rate from the band over Bluetooth (LiveHeart). Never used to find your location. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and older only: a Bluetooth search needs these there. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Air quality near you: rough location only, only while Pulse is open. Asked only when the user switches it on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Google Health (the former Fitbit app): "Get newest data" opens it, so it syncs the band. -->
        <package android:name="com.fitbit.FitbitMobile" />
    </queries>

    <!-- allowBackup=false: health data must never go to cloud backups. -->
    <application
        android:name=".PulseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulse">
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect's "privacy policy" link: Android 13 and older, then Android 14 and newer. -->
        <activity android:name=".PermissionsRationaleActivity" android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widgets (Jetpack Glance). One receiver per widget. -->
        <receiver android:name=".ui.widget.SmartWidgetReceiver" android:exported="false" android:label="Pulse · Smart">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_smart" />
        </receiver>
        <receiver android:name=".ui.widget.StepsWidgetReceiver" android:exported="false" android:label="Pulse · Steps">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_steps" />
        </receiver>
        <receiver android:name=".ui.widget.HeartWidgetReceiver" android:exported="false" android:label="Pulse · Heart">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_heart" />
        </receiver>
        <receiver android:name=".ui.widget.SleepWidgetReceiver" android:exported="false" android:label="Pulse · Sleep">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sleep" />
        </receiver>
        <receiver android:name=".ui.widget.SyncWidgetReceiver" android:exported="false" android:label="Pulse · Sync">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sync" />
        </receiver>

        <!-- Drawn widgets: one receiver per size, the picture is chosen in the set-up page. -->
        <receiver android:name=".ui.widget.art.TinyArtReceiver" android:exported="false" android:label="Pulse picture 1 × 1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_tiny" />
        </receiver>
        <receiver android:name=".ui.widget.art.PillArtReceiver" android:exported="false" android:label="Pulse picture 2 × 1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_pill" />
        </receiver>
        <receiver android:name=".ui.widget.art.SquareArtReceiver" android:exported="false" android:label="Pulse picture 2 × 2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_square" />
        </receiver>
        <receiver android:name=".ui.widget.art.StripArtReceiver" android:exported="false" android:label="Pulse picture 4 × 1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_strip" />
        </receiver>
        <receiver android:name=".ui.widget.art.WideArtReceiver" android:exported="false" android:label="Pulse picture 4 × 2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_wide" />
        </receiver>
        <receiver android:name=".ui.widget.art.LargeArtReceiver" android:exported="false" android:label="Pulse picture 4 × 4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_art_large" />
        </receiver>
        <activity android:name=".WidgetConfigActivity" android:exported="true" android:label="Pulse widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
    </application>

</manifest>
