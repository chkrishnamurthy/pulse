<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false: health data must never go to cloud backups. -->
    <application
        android:name=".PulseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulse">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (Jetpack Glance). One receiver per widget. -->
        <receiver android:name=".ui.widget.SmartWidgetReceiver" android:exported="false" android:label="Pulse · Smart">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_smart" />
        </receiver>
        <receiver android:name=".ui.widget.StepsWidgetReceiver" android:exported="false" android:label="Pulse · Steps">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_steps" />
        </receiver>
        <receiver android:name=".ui.widget.HeartWidgetReceiver" android:exported="false" android:label="Pulse · Heart">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_heart" />
        </receiver>
        <receiver android:name=".ui.widget.SleepWidgetReceiver" android:exported="false" android:label="Pulse · Sleep">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sleep" />
        </receiver>
        <receiver android:name=".ui.widget.SyncWidgetReceiver" android:exported="false" android:label="Pulse · Sync">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sync" />
        </receiver>
    </application>

</manifest>
